{% case media.media_type %}
    {% when "image" %}
        <img src="{{ media | image_url: width: 100, height:100 }}" width="100" height="100" alt="">
    {% when "external_video" %}
        {{ media | external_video_tag: class: "w-full h-80 object-cover" }}
    {% when "video" %}
        {{ media | video_tag: class: "w-full h-80 object-cover" }}

    {% when "model" %}
        {{ media | model_viewer_tag }}
    {% else %}
        {{ media | media_tag }}
{% endcase %}