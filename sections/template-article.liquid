    <article class="max-w-3xl mx-auto">
        {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
                {% case block.type %}
                {% when "article_title" %}
                        <h1 class="text-4xl mb-10 font-bold  border-b-4 border-amber-200 " itemprop="headline">{{ article.title }}</h1>
                    {% when "article_author" %}
                        {% if section.settings.enable_author %}     
                            <div itemscope itemprop="http://schema.org/Person">    
                            <h4 class="" itemprop="author">Author: {{ article.author }}</h4>
                        </div>
                    {% endif %}
            {% when "article_published_date" %}
                {% if section.settings.enable_published_date %}
                    <time datetime="{{ article.published_at | date: "%Y-%m-%d" }}">{{ article.published_at | date: "%Y-%m-%d" }}</time>
                {% endif %}
            {% when "featured_image" %}
                {% if article.image != blank %}
                    <img src="{{ article.image | image_url: width:300  }}" alt="{{ article.image.alt }}" width="120" height="120">
                {% endif %}
            {% when "article_content" %}
                {{ article.content  }}
            {% else %}
            {% endcase %}
        {% endfor %}
    {% endif %}
    </article>  

    {% if blog.comments_enabled? %}
        <div id="comments" class="my-8">
            {% if article.comments_count > 0 %}
                <h1>See what people are saying</h1>
                {% paginate article.comments by 5 %}
                    {% for comment in article.comments %}
                        <div class="flex-1 border my-4 border-amber-500">
                            <span class="text-4xl ">
                                {{ comment.author }}
                            </span>
                            <span>
                                {{ comment.content }}
                            </span>
                            <span>
                                {{ comment.created_at | date: format: "default" }}
                            </span>
                        </div>
                    {% endfor %}
                    
                    <div class="max-w-6xl mx-auto">
                        {% render "pagination", pagination: paginate %}
                    </div>
                {% endpaginate %}
            {% else %}
                There are no comments in this article
            {% endif %}        
        </div> 
        <div>
            {% form "new_comment", article %}
                <div>
                    {% if form.errors %}
                        <div>
                            <div>
                                <div class="text-red-500">
                                    {% render "icon-failed" %}
                                </div>
                                <div>
                                    Oh no, your comment has not been published.
                                </div>
                                <ul>
                                    {% for error in form.errors %}
                                        <li>
                                            <span>{{ form.errors.messages[error] }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    {% elsif form.posted_successfully? %}
                        <div class="flex flex-row items-center w-full my-3 py-3">
                            <div class="text-green-500">
                                {% render "icon-succeeded" %}
                            </div>
                            <div class="text-sm font-medium ml-3">
                                Comment is posted successfully
                            </div>
                        </div>
                    {% endif %}
                    <div>
                        <label for="comment_author">Name:</label>
                        <input type="text" name="comment[author]" id="comment_author" placeholder="John Doe" required>
                    </div>
                    <div>
                        <label for="comment_email">Email:</label>
                        <input type="email" name="comment[email]" id="comment_email" placeholder="John@gmail.com" required>
                    </div>
                    <div>
                        <label for="comment_content">Textarea:</label>
                        <textarea name="comment[body]" id="comment_content">{{ form.body }}</textarea>
                    </div>
                    <button type="submit">send</button>
                </div>
            {% endform %}
        </div>
    {% endif %}

    {% schema %}
        {
            "name": "Template Article",
            "settings": [
                {
                    "type": "checkbox",
                    "id": "enable_author",
                    "default": true,
                    "label": "Display Author Name"
                },
                {
                    "type": "checkbox",
                    "id": "enable_published_date",
                    "default": true,
                    "label": "Display Published Date"
                },
                {
                    "type": "range",
                    "id": "number_of_comments",
                    "label": "Comments",
                    "step": 1,
                    "min": 1,
                    "max": 5,
                    "default": 2,
                }
            ],
            "blocks": [
                {
                    "type": "article_title",
                    "name": "Title",
                    "limit": 1
                },
                {
                    "type": "article_author",
                    "name": "Author",
                    "limit": 1
                }, 
                {
                    "type": "article_published_date",
                    "name": "Published Date",
                    "limit": 1
                }, 
                {
                    "type": "featured_image",
                    "name": "Thumbnail",
                    "limit": 2
                },
                {
                    "type": "article_content",
                    "name": "Content",
                    "limit": 2
                }
            ]
        }
    {% endschema %}