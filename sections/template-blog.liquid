<div class="my-8">    
    {% paginate blog.articles by section.settings.number_of_blog_posts %}
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% for article in blog.articles %}
                    <div class="w-full py-6 px-3 bg-zinc-50">
                        {% if article.image %}
                            <img src="{{ article.image | image_url: "master" }}" width="500" height="100" alt="{{ article.image.alt }}">
                        {% else %}
                            {{ "image" | placeholder_svg_tag: "w-20" }}
                        {% endif %}
                        <div class="p-4">
                            <h1 class="font-medium">
                                {{ article.title }}
                            </h1>
                            {% if article.excerpt.size > 0 %}
                                <p>{{ article.excerpt | strip_html | truncate: 15 }}</p>
                            {% else %}
                                <p class=" py-6  text-black">{{ article.content | strip_html |  truncatewords: 15 }}22</p>
                            {% endif %}
                            <a href="{{ article.url }}" class="font-medium text-blue-600 hover:text-blue-800">{{ section.settings.blog_read_more }}</a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            <div class="max-6xl mx-auto">
                {% render "pagination", pagination: paginate %}
            </div>
    {% endpaginate %}
</div>
    
    
    {% schema %}
    {
        "name": "Blog",
        "settings": [
            {
                "type": "text",
                "id": "blog_read_more",
                "default": "Read More",
                "label": "Read more label!"
            },
            {
                "type": "range",
                "id": "number_of_blog_posts",
                "label": "Blog posts per page",
                "step": 1,
                "min": 1,
                "max": 6,
                "default": 2,
            }
        ]
    }
{% endschema %}